# ============================================================
#  Fortnite Item Shop Monitor - credentials
#  Copy this file to ".env" and fill in what you use.
#  ".env" is gitignored and must NEVER be committed.
# ============================================================

# ---- Discord (recommended, easiest) ------------------------
# Discord -> Server Settings -> Integrations -> Webhooks
# -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=

# ---- Telegram (optional, works alongside Discord) ----------
# 1. Talk to @BotFather -> /newbot -> copy the token
# 2. Send your bot any message, then run:  python tools/telegram_chat_id.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Optional overrides ------------------------------------
# mock mode for testing without touching the real API
# FORTNITE_SHOP_SOURCE=mock
# LOG_LEVEL=INFO
